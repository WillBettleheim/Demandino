# Copy to .env (never committed) or set these on your server. Keep real values out of the code.
# Encrypts saved connector keys. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEMANDINO_SECRET_KEY=
